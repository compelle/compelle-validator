[Unit]
Description=Compelle Validator (Bittensor SN82)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=compelle
Group=compelle
WorkingDirectory=/opt/compelle-validator
EnvironmentFile=/etc/compelle/env
ExecStart=/opt/compelle-validator/.venv/bin/python -m compelle.validator
Restart=always
RestartSec=30
# Exit 2 = preflight rejected the config (missing CHUTES_API_KEY, missing
# wallet, etc.). Looping makes the journal log spam and hides the real error;
# stop and let the operator fix the env. Exit 3 (watchdog) MUST keep restarting
# because that is the recovery mechanism for a wedged Subtensor RPC.
RestartPreventExitStatus=2
StandardOutput=journal
StandardError=journal

OOMScoreAdjust=-200
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/compelle
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
