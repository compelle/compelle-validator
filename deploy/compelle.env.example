# Compelle validator environment.
# Copy to /etc/compelle/env (root-owned, mode 0600) and fill in the values.

# Chutes inference (required)
CHUTES_API_KEY=

# Bittensor wallet (required)
BT_WALLET_NAME=
BT_HOTKEY=

# Subnet + chain (defaults shown)
BT_NETUID=82
BT_NETWORK=finney

# Optional: override the Chutes API base URL
# CHUTES_BASE_URL=https://llm.chutes.ai/v1

# Optional: override the public transcript-aggregation endpoint.
# Validators sign and POST each epoch file here so anyone can audit results.
# Set to empty string to disable pushing.
# COMPELLE_PUSH_URL=https://compelle.com/ingest
