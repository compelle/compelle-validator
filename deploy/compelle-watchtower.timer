[Unit]
Description=Run Compelle Watchtower every 10 minutes
Documentation=https://github.com/compelle/compelle-validator

[Timer]
# 10-min cadence: balance between fast pickup of urgent fixes vs github API
# polling rate. Adjust if you want less frequent (e.g., OnUnitActiveSec=1h).
OnBootSec=120
OnUnitActiveSec=600
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
